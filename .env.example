# =============================================================================
# Game Tracker - modelo de variáveis de ambiente (PGC 4.1)
# Copie para `.env` e preencha localmente. O `.env` NÃO vai para o Git.
# Aqui ficam só os NOMES das variáveis, nunca valores reais.
# Hoje o app não lê nenhuma destas variáveis (dados em memória).
# =============================================================================

# ---------- Aplicação ----------
APP_NAME=
APP_ENV=                 # development | staging | production
APP_DEBUG=
SHOW_DEBUG_BANNER=

# ---------- Tema ----------
THEME_SEED_COLOR=
USE_MATERIAL3=

# ---------- Dados ----------
DATA_SOURCE=             # local | api | database

# ---------- API / Backend (futuro) ----------
API_BASE_URL=
API_TIMEOUT_SECONDS=
API_KEY=

# ---------- Banco de dados (futuro) ----------
DB_NAME=

# ---------- Firebase (futuro) ----------
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# ---------- APIs externas de jogos (futuro) ----------
RAWG_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

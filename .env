# =============================================================================
# Game Tracker - variáveis de ambiente
# Projeto Flutter (Dart SDK ^3.12.2) | Plataformas: Android, Web, Windows, Linux
# =============================================================================
# ATENÇÃO: hoje o app NÃO consome nenhuma variável deste arquivo (não há
# chamadas de API, banco ou chaves no código). Os valores abaixo espelham a
# configuração atual do projeto e já deixam a estrutura pronta para quando
# você adicionar backend/serviços.
# =============================================================================
 
# ---------- Aplicação ----------
APP_NAME=Game Tracker
APP_ENV=development            # development | staging | production
APP_VERSION=1.0.0+1            # mesmo valor do pubspec.yaml
APP_DEBUG=true
SHOW_DEBUG_BANNER=false        # main.dart usa debugShowCheckedModeBanner: false
 
# ---------- Identificação (Android) ----------
ANDROID_APPLICATION_ID=com.example.game_tracker
 
# ---------- Tema ----------
THEME_SEED_COLOR=deepPurple    # main.dart usa Colors.deepPurple + Material 3
USE_MATERIAL3=true
 
# ---------- Dados ----------
# Hoje a lista de jogos vem de `initialGames` (lib/models/game.dart), em memória.
DATA_SOURCE=local              # local | api | database
 
# ---------- API / Backend (descomente quando for usar) ----------
# API_BASE_URL=http://10.0.2.2:3000     # 10.0.2.2 = localhost no emulador Android
# API_TIMEOUT_SECONDS=15
# API_KEY=
 
# ---------- Banco de dados (descomente quando for usar) ----------
# DB_NAME=game_tracker.db
 
# ---------- Firebase (descomente quando for usar) ----------
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=
# FIREBASE_APP_ID=
# FIREBASE_MESSAGING_SENDER_ID=
 
# ---------- APIs externas de jogos (ex.: capas e metadados) ----------
# RAWG_API_KEY=
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
 